# Node dependencies
node_modules/

# Build output
build/
dist/
src-python/build/
src-python/dist/
src-tauri/target/

# Rust/Cargo specific ignores
**/target/
Cargo.lock
Cargo.lock.backup
.debug/
debug/
release/
*.pdb
*.rlib
*.dylib
*.so
*.dll
!oo2core_9_win64.dll
*.dll.exp
*.dll.lib
*.a
*.lib
*.exe
rustc_info.json
rustfmt.toml

# Environment files and secrets
.env
.env.*

# Logs and temporary files
*.log
logs/
tmp/
*.tmp
Untitled*.json
tmp_*.json
test_api_output.json

# Backup artifacts
backup/
*.bak
# ...but core/backup/ is the backup/restore SOURCE MODULE, not an artifact
# directory. The blanket "backup/" pattern above matches any directory of that
# name at any depth, which silently excluded it from every commit.
!core/backup/
!core/backup/**

# Python caches and artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-wheel-metadata/
*.egg-info/

# Virtual environments
venv/
.venv/

# Databases and local state
*.db
*.db-shm
*.db-wal

# IDE/editor metadata
.idea/
*.iml
.DS_Store
Thumbs.db

# Coverage reports
.coverage
.coverage.*
coverage/
coverage.xml

# Parcel/Vite cache
.parcel-cache/
.vite/

# TypeScript incremental cache
*.tsbuildinfo

# Desktop sidecar artifacts
src-tauri/sidecars/rivalnxt_backend.exe

# Editor / IDE
.vscode/

# Tauri sidecars (ignore all sidecar builds)
src-tauri/sidecars/

# Local env overrides and secrets
.env.local
.env.*.local
.envrc

# Node/npm/Yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache directories
.cache/
.parcel-cache/
.vite/

# Certificates / private keys
*.pem
*.key
*.crt

# Common OS files
desktop.ini
Thumbs.db

# Test / temp helpers (developer local files that shouldn't be committed)
.vscode-test/

# Temporary working folders created by scripts or local runs
temp/
temp_*/
temp_activation/

# Local test output
test-output/
test-results/
*.trx

# Documentation and developer-only assets
docs/
# NOTE: "tests/" used to be ignored here as a developer scratch area. It now
# holds the pytest suite that .github/workflows/ci.yml runs, so it MUST be
# tracked -- with the blanket ignore in place a fresh clone contained no tests
# and the backend CI job silently passed on an empty suite.
# __pycache__ is already excluded globally (see above).

# Additional paths tracked locally for build hygiene
tauri_non_build_files.txt
test/
test_*/

# Test scripts (temporary testing files)
test_folder_ingestion.py
test_bootstrap_complete.py
check_db.py
test_api.py
temp_conflict_view_debug.py

# PowerShell scripts
*.ps1

# codeviz files
*.codeviz

# wheel files
extracted_wheel/
*.whl
*.whl.info
*.dist-info/

#scratch files
**/scratch/

# Graphify
graphify-out/

# Ignore AI assistant configuration and rule directories
.agents/
.codex/
.cursor/

# Test scaffolding (local only)
.venv-test/
.pytest-data/
requirements-ci.txt
