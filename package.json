    "vite": "6.3.5",
    "vitest": "^4.0.16"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "activate-mods": "python -X utf8 -m scripts.activate_mods",
    "deactivate-mods": "python -X utf8 -m scripts.deactivate_mods",
    "py:build": "python -m PyInstaller --noconfirm --clean rivalnxt_backend_merged.spec",
    "py:copy": "node -e \"require('fs').copyFileSync('dist/rivalnxt_backend.exe', 'src-tauri/sidecars/rivalnxt_backend-x86_64-pc-windows-msvc.exe')\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "node -e \"delete process.env.CI; require('child_process').execSync('tauri build', {stdio:'inherit'})\"",
    "desktop:dev": "yarn tauri:dev",
    "desktop:build": "yarn build && yarn py:build && yarn py:copy && yarn tauri:build",
    "build:local": "npm run build && node -e \"require('os').platform() === 'win32' ? require('child_process').execSync('build_local.bat', {stdio: 'inherit'}) : require('child_process').execSync('./build_local.sh', {stdio: 'inherit'})\"",
    "build:ci": "bash build_cicd.sh",
    "version": "node scripts/sync-version.js && git add src-tauri/tauri.conf.json"
  }
}
